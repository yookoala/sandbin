{
  "openapi": "3.1.1",
  "info": {
    "title": "sandbin HTTP API",
    "description": "The sandbin JSON API: keys, bins and bin metadata under /api. Errors answer plain text with a fixed sentence; successes answer JSON.",
    "version": "1.0.0",
    "contact": {
      "name": "sandbin",
      "url": "https://github.com/yookoala/sandbin"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "paths": {
    "/api": {
      "get": {
        "summary": "Index of this API: every published endpoint in one JSON body.",
        "description": "Answers 200 application/json with the server's version stamp, every published endpoint with a full URL built from the request's own host and scheme and a description for each method, and an openapi sibling pointing at this document. Needs no API key, touches no store and charges nothing, so it answers even while the requesting address is blocked.",
        "operationId": "apiIndex",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/apiIndexDoc"
                }
              }
            }
          }
        },
        "security": []
      },
      "head": {
        "summary": "Index of this API — headers only.",
        "description": "Answers 200 with no body. Needs no API key, touches no store and charges nothing, so it answers even while the requesting address is blocked.",
        "operationId": "headAPIIndex",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": []
      }
    },
    "/api/bins": {
      "get": {
        "summary": "List this instance's bins, newest first.",
        "description": "Answers 200 with a page of bin objects and, only when a further page exists, the next_cursor that resumes the walk after the page's last one. limit defaults to 30 and clamps to 100; a non-integer or a limit below 1 answers 400 invalid limit. cursor is the opaque unpadded URL-safe base64 a previous page answered; a malformed one answers 400 invalid cursor. Protected bins list with their full metadata in plain view. Key-checked: a wrong API key answers 403 and costs the requesting address a lockout step.",
        "operationId": "listBins",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/binListJSON"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "invalid-limit": {
                    "value": "invalid limit"
                  },
                  "invalid-cursor": {
                    "value": "invalid cursor"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "invalid API key"
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "too many bad API keys"
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the requesting address's API-key lockout expires.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      },
      "post": {
        "summary": "Create a bin from a JSON body.",
        "description": "Answers 201 with the new bin's object and a Location naming /api/bins/{hash} for it. The body may name any mix of title, description and password: an absent field and one given as null or \"\" both make the empty value. A title over 200 bytes or carrying control characters, a description over 2000 bytes or carrying control characters, or a password over the 72 bytes bcrypt can hash is refused with 400 and creates nothing. Key-checked: a wrong API key answers 403 and costs the requesting address a lockout step.",
        "operationId": "createBin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RawMessage"
              }
            }
          },
          "required": false
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/binJSON"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "The new bin's API path: /api/bins/{hash}.",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "unreadable-request": {
                    "value": "could not read the request"
                  },
                  "unrecognized-field": {
                    "value": "unrecognized field in the request"
                  },
                  "title-over-limit": {
                    "value": "title over 200 bytes"
                  },
                  "title-control-characters": {
                    "value": "title may not contain control characters"
                  },
                  "description-over-limit": {
                    "value": "description over 2000 bytes"
                  },
                  "description-control-characters": {
                    "value": "description may not contain control characters"
                  },
                  "password-over-limit": {
                    "value": "bin password too long"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "invalid API key"
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "too many bad API keys"
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the requesting address's API-key lockout expires.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
    "/api/bins/{hash}": {
      "get": {
        "summary": "Inspect a bin: its object and every file it holds.",
        "description": "Answers 200 with the bin object plus its files — path, size and updated_at — sorted by path, even for a bin whose base is covered by a stored index.html. Needs no API key. A password-protected bin answers 401 bin password required until its password is given as Basic Auth, and that 401 charges nothing.",
        "operationId": "inspectBin",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/binDetailJSON"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "bin password required"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "unknown bin"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "binBasic": []
          }
        ]
      },
      "delete": {
        "summary": "Delete a bin and every file in it.",
        "description": "Carries no request body and answers 204 with an empty body. Key-checked: a wrong API key answers 403 and costs the requesting address a lockout step; a protected bin answers 401 bin password required until Basic Auth carries its current password, and that 401 charges nothing.",
        "operationId": "deleteBin",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "bin password required"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "invalid API key"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "unknown bin"
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "too many bad API keys"
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the requesting address's API-key lockout expires.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      },
      "patch": {
        "summary": "Edit a bin's title, description and password.",
        "description": "A merge with three states per field: present in the body it replaces the stored value — given as null or \"\" it clears it — absent it leaves what the bin holds. {} is a no-op answering the current row; a bodyless request is refused 400. A given password is stored as a bcrypt hash, at most 72 bytes. Key-checked: a wrong API key answers 403 and costs the requesting address a lockout step; a protected bin also needs its current password as Basic Auth for every change, rotating or clearing the password included, and that 401 charges nothing. A refused request changes nothing; an accepted one answers 200 with the bin object as it now stands.",
        "operationId": "patchBin",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RawMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/binJSON"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "unreadable-request": {
                    "value": "could not read the request"
                  },
                  "unrecognized-field": {
                    "value": "unrecognized field in the request"
                  },
                  "title-over-limit": {
                    "value": "title over 200 bytes"
                  },
                  "title-control-characters": {
                    "value": "title may not contain control characters"
                  },
                  "description-over-limit": {
                    "value": "description over 2000 bytes"
                  },
                  "description-control-characters": {
                    "value": "description may not contain control characters"
                  },
                  "password-over-limit": {
                    "value": "bin password too long"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "bin password required"
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "invalid API key"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "unknown bin"
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "too many bad API keys"
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the requesting address's API-key lockout expires.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "summary": "Liveness probe: answers {\"status\":\"ok\"}.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/healthBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "description": "Needs no API key and charges nothing, so it answers even while the requesting address is blocked. Says nothing about bins."
      },
      "head": {
        "summary": "Liveness probe: answers {\"status\":\"ok\"}.",
        "operationId": "headHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/healthBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "description": "Needs no API key and charges nothing, so it answers even while the requesting address is blocked. Says nothing about bins."
      }
    },
    "/api/key": {
      "post": {
        "summary": "Check an API key without creating anything.",
        "description": "A working key answers 204 with an empty body and creates nothing. A wrong key answers 403 and costs the requesting address the same lockout step as a wrong key on a write.",
        "operationId": "checkApiKey",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "invalid API key"
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                },
                "example": "too many bad API keys"
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the requesting address's API-key lockout expires.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Fetch this OpenAPI document.",
        "description": "Answers 200 application/json with this machine-readable contract for the /api surface — the document committed with the server's source, served byte for byte. Needs no API key, touches no store and charges nothing, so it answers even while the requesting address is blocked.",
        "operationId": "getOpenAPIDocument",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The OpenAPI 3.1 document itself: the committed cmd/sandbin/openapi.json, served byte for byte."
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "RawMessage": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "apiIndexDoc": {
        "type": "object",
        "description": "apiIndexDoc is the GET /api answer: the stamped version, the endpoint rows enumerated from\nthe route table, and the openapi sibling pointing at the machine-readable contract.",
        "properties": {
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/apiIndexEndpoint"
            }
          },
          "openapi": {
            "$ref": "#/components/schemas/apiIndexLink"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "endpoints",
          "openapi"
        ],
        "additionalProperties": false
      },
      "apiIndexEndpoint": {
        "type": "object",
        "description": "apiIndexEndpoint is one row of the index: the URL as the visitor can fetch it — the literal\n{hash} spelling for the per-bin row, same as the OpenAPI document uses — and every method the\nroute table allows on that path, in the table's canonical order.",
        "properties": {
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/apiIndexMethod"
            }
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "methods"
        ],
        "additionalProperties": false
      },
      "apiIndexLink": {
        "type": "object",
        "description": "apiIndexLink is a pointer to a document: its full URL and one sentence about it.",
        "properties": {
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "description"
        ],
        "additionalProperties": false
      },
      "apiIndexMethod": {
        "type": "object",
        "description": "apiIndexMethod is one published method on one endpoint, with the decision doc's sentence for\nit.",
        "properties": {
          "description": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        },
        "required": [
          "method",
          "description"
        ],
        "additionalProperties": false
      },
      "binDetailJSON": {
        "type": "object",
        "description": "binDetailJSON is the inspect answer: the bin object plus every file the bin holds. The bin's\nown HTML page hides that list whenever an index.html covers the base; the API never does.",
        "properties": {
          "bin": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/fileJSON"
            }
          },
          "has_password": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "bin",
          "url",
          "title",
          "description",
          "has_password",
          "created_at",
          "files"
        ]
      },
      "binJSON": {
        "type": "object",
        "description": "binJSON is the bin object every JSON answer about a bin carries: its hash, the path it lives\nunder, its metadata, whether a password guards it, and when the store made it. Neither the\npassword nor its hash is ever in it.",
        "properties": {
          "bin": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "has_password": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "bin",
          "url",
          "title",
          "description",
          "has_password",
          "created_at"
        ]
      },
      "binListJSON": {
        "type": "object",
        "description": "binListJSON is the GET /api/bins answer: the page of bin objects and, only when the store's\nprobe found a further row, the cursor that resumes the walk after the page's last one.",
        "properties": {
          "bins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/binJSON"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "bins"
        ]
      },
      "fileJSON": {
        "type": "object",
        "description": "fileJSON spells one file row for the JSON answers that name a bin's contents.",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "size",
          "updated_at"
        ]
      },
      "healthBody": {
        "type": "object",
        "description": "healthBody is the /api/health answer.",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "archiveAnswer": {
        "type": "object",
        "description": "archiveAnswer is the JSON a successful archive upload answers: the store's own created and replaced counts for the extracted entries.",
        "required": [
          "created",
          "replaced"
        ],
        "properties": {
          "created": {
            "type": "integer"
          },
          "replaced": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      },
      "binBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
